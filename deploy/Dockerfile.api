FROM python:3.12-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files first for layer caching
COPY pyproject.toml uv.lock ./

# Install dependencies
RUN uv sync --frozen --no-dev

# Copy application code
COPY geointel/ geointel/
# main.py mounts this directory as the static frontend; without it the API
# still boots (mount is skipped if missing) but serves no UI.
COPY frontend/ frontend/

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "geointel.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
